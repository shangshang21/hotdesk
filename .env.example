# Optional; copy to .env only if you want the app to invoke a model independently.
# Agent-driven MCP/CLI mode does not require a model key.
HOTDESK_PORT=4317
# Full OpenAI-compatible chat/completions endpoint, not a bare base URL.
# HOTDESK_MODEL_ENDPOINT=https://your-provider.example/v1/chat/completions
# HOTDESK_MODEL=your-model-id
# HOTDESK_MODEL_KEY=your-key
# Optional authorized Reddit API bearer token. Never put tokens in source inputs.
# REDDIT_ACCESS_TOKEN=your-token
