{
  "name": "hotdesk-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地热点内容生产工作台 / Local-first agent-ready content pipeline",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "cli": "node --env-file-if-exists=.env src/cli.mjs",
    "mcp": "node --env-file-if-exists=.env src/mcp.mjs",
    "setup:agents": "node scripts/setup-agents.mjs",
    "test": "node --experimental-test-module-mocks --test tests/*.test.mjs",
    "check": "node --check src/server.mjs && node --check public/app.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.3.6",
    "fflate": "0.8.3",
    "linkedom": "^0.18.13",
    "zod": "^3.25.76"
  }
}
